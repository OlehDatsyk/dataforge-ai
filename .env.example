# =============================================================
# DataForge AI - Environment Configuration
# Copy this file to ".env" and fill in the values you have.
# Every value is optional - the app runs with none of them set,
# it will simply run in "deterministic analysis only" mode with
# AI features returning a clear "no provider available" message.
# =============================================================

# ---- AI Provider API Keys (leave blank if you don't have one) ----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ---- AI Model Names (sensible defaults are used if left blank) ----
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
GEMINI_MODEL=gemini-1.5-flash

# ---- Provider fallback order ----
# Automatic mode tries PRIMARY, then FALLBACK, then SECONDARY_FALLBACK.
PRIMARY_AI_PROVIDER=openai
FALLBACK_AI_PROVIDER=anthropic
SECONDARY_FALLBACK_AI_PROVIDER=gemini

# ---- Upload / dataset limits ----
MAX_UPLOAD_SIZE_MB=15
MAX_ROWS=100000

# ---- Database ----
# Leave blank to use local SQLite (recommended for local use).
# On Render, set to a PostgreSQL connection string if you attach a
# managed Postgres database. If left blank on Render, SQLite is used
# but will NOT persist across deploys/restarts (see README).
DATABASE_URL=

# ---- AI request behaviour ----
AI_REQUEST_TIMEOUT_SECONDS=30
